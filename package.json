{
  "name": "skyl-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation site for skyl \u2014 one Go interface for every AI model.",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:links": "node scripts/check-links.mjs",
    "check:snippets": "node scripts/check-snippets.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:links && npm run check:wire",
    "emit:md": "node scripts/emit-markdown.mjs",
    "prebuild": "node scripts/emit-markdown.mjs",
    "check:wire": "node scripts/check-wire-snippets.mjs"
  },
  "dependencies": {
    "next": "^15.5.26",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.36.0",
    "@mdx-js/mdx": "^3.1.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.3.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "github-slugger": "^2.0.0",
    "globals": "^16.4.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^30.1.1",
    "next-mdx-remote-client": "^2.1.12",
    "prettier": "^3.9.9",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "serve": "^14.2.6",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.1",
    "unist-util-visit": "^5.1.0",
    "vitest": "^5.0.2"
  }
}
